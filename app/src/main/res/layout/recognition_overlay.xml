<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating recognition capsule drawn over other apps. Rounded, translucent, non-focusable.
  Colours are fixed rather than theme-driven: an overlay sits above arbitrary app content, so a
  dark scrim with light text is the only combination guaranteed to stay legible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/recognition_overlay_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:minWidth="240dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/overlay_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/widget_recognizer_mic_desc"
        android:src="@drawable/ic_widget_mic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_recognizer_listening"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_recognizer_name"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
