<?xml version="1.0" encoding="utf-8"?>
<!--
  Music Recognizer widget.

  A single tappable surface: idle it says "Tap to identify a song", while listening it shows the
  pulse ring, and on success it shows cover art + title/artist. All state is pushed by
  RecognitionForegroundService through widget_recognizer_prefs (see RecognizerWidgetReceiver).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:theme="@style/Theme.Widget.Metrolist">

    <LinearLayout
        android:id="@+id/widget_recognizer_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Artwork / pulse ring. Hidden by the receiver until a match is found. -->
        <ImageView
            android:id="@+id/widget_recognizer_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/album_art" />

        <ImageView
            android:id="@+id/widget_recognizer_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_widget_play_low"
            android:contentDescription="@string/widget_recognizer_mic_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_recognizer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_recognizer_tap_to_search"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/widget_recognizer_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_recognizer_name"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
