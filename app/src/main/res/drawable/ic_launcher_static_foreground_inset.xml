<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground for the real Mentsic logo.

    The source PNG was cropped to the artwork's own rounded tile (its white margin removed), so it
    already fills the canvas edge to edge. An 11% inset keeps the tile's corners inside the 72dp
    safe zone every launcher mask respects; the background colour matches the tile, so a circular
    or squircle mask shows the logo on its own dark ground rather than a white ring.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_static_foreground"
    android:inset="11%" />
