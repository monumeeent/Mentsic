<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background — glass-style translucent scrim.

  RemoteViews cannot render a real blur (no RenderEffect support), and the system widget blur is
  API 31+ and launcher-dependent. A low-alpha dark scrim plus a hairline border reads as glass on
  every launcher and keeps white text legible over any wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D9101114" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
